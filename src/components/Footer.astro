---
import { site } from '../data/site';

const lastUpdated = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date());
---

<footer class="border-border bg-bg border-t">
  <div
    class="text-muted mx-auto flex max-w-content flex-col gap-2 px-4 py-6 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>Built with Astro, deployed on GitHub Pages</p>
    <p>Last updated {lastUpdated}</p>
    <a
      href={site.source}
      class="text-accent hover:text-accent no-underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Site source
    </a>
  </div>
</footer>
