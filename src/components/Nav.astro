---
import ThemeToggle from './islands/ThemeToggle';
import { site } from '../data/site';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/resume', label: 'Resume' },
];
---

<header
  class="border-border bg-bg/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-content min-w-0 items-center justify-between gap-2 px-4 py-3 sm:gap-4 sm:px-6"
    aria-label="Primary"
  >
    <a href="/" class="font-mono text-sm font-medium text-text no-underline">rd_</a>

    <div class="flex min-w-0 flex-wrap items-center justify-end gap-x-2 gap-y-1 sm:gap-x-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-muted hover:text-text text-sm no-underline transition-colors duration-200 ease-out-soft"
          >
            {link.label}
          </a>
        ))
      }

      <button
        type="button"
        id="command-palette-trigger"
        class="border-border text-muted inline-flex items-center gap-1 rounded-md border px-2 py-1 font-mono text-xs"
        aria-label="Open command palette"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="command-palette"
      >
        <span>Cmd K</span>
      </button>

      <ThemeToggle client:load />

      <a
        href={site.github}
        class="text-muted hover:text-text"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>

      {
        site.linkedin && (
          <a
            href={site.linkedin}
            class="text-muted hover:text-text"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        )
      }
    </div>
  </nav>
</header>
