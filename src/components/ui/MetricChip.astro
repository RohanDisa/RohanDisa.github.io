---
interface Props {
  value: string;
  label?: string;
}

const { value, label } = Astro.props;
---

<span
  class="border-border bg-surface-2 inline-flex max-w-full items-baseline gap-1.5 rounded-md border px-2 py-1 font-mono text-sm"
>
  <span class="text-text font-medium">{value}</span>
  {
    label && (
      <span class="text-muted text-xs font-normal break-words">{label}</span>
    )
  }
</span>
