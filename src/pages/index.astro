---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/islands/CopyEmail';
import HeroTrace from '../components/islands/HeroTrace';
import RaftSim from '../components/islands/RaftSim';
import ToolCallCard from '../components/ToolCallCard.astro';
import MetricChip from '../components/ui/MetricChip.astro';
import SectionEyebrow from '../components/ui/SectionEyebrow.astro';
import SpanBar from '../components/ui/SpanBar.astro';
import TraceLine from '../components/ui/TraceLine.astro';
import { site } from '../data/site';
import {
  formatYearMonth,
  getProjects,
  projectHref,
  spanRange,
} from '../lib/content';
import { getCollection } from 'astro:content';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured).slice(0, 4);
const agentProjects = projects.filter((project) => project.data.lane === 'agents').slice(0, 3);
const systemProjects = projects.filter((project) => project.data.lane === 'systems').slice(0, 3);
const kvProject = projects.find((project) => project.data.interactive === 'raft-sim');

const experience = (await getCollection('experience')).sort(
  (a, b) => (a.data.start < b.data.start ? 1 : -1),
);
const oss = await getCollection('oss');
---

<Base
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: site.jobTitle,
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: site.alumniOf,
    },
    sameAs: [site.github, site.linkedin],
    url: new URL('/', Astro.site).href,
    email: site.email,
  }}
>
  <section class="relative isolate md:min-h-[calc(100vh-6rem)]">
    <div class="hero-dots pointer-events-none absolute inset-0 -z-10"></div>
    <div class="grid grid-cols-1 items-center gap-8 py-8 md:grid-cols-12 md:gap-6 md:py-12">
      <div class="min-w-0 md:col-span-7">
        <p class="text-muted font-mono text-xs tracking-eyebrow uppercase">{site.eyebrow}</p>
        <h1 class="text-text mt-4 text-2xl tracking-heading sm:text-3xl lg:text-hero">
          {site.pitch}
        </h1>
        <p class="text-muted mt-5 max-w-xl text-base sm:text-lg">{site.subline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#selected-work"
            class="bg-accent text-bg inline-flex rounded-md px-4 py-2 text-sm font-medium no-underline"
          >
            View work
          </a>
          <a
            href="/resume"
            class="border-border text-text inline-flex rounded-md border px-4 py-2 text-sm no-underline"
          >
            Resume
          </a>
        </div>
        <p class="text-muted mt-6 font-mono text-xs sm:text-sm">{site.availability}</p>
      </div>
      <div class="min-w-0 md:col-span-5">
        <HeroTrace client:load />
      </div>
    </div>
  </section>

  <section id="what-i-build" class="reveal mt-20 md:mt-28">
    <SectionEyebrow index="01" title="What I build" heading />
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-12">
      <article class="border-border bg-surface min-w-0 rounded-lg border p-5 md:col-span-7">
        <h3 class="text-xl font-semibold">{site.lanes.agents.title}</h3>
        <p class="text-muted mt-3">{site.lanes.agents.body}</p>
        <ul class="mt-5 flex flex-col gap-2">
          {
            agentProjects.map((project) => (
              <li>
                <a href={projectHref(project)} class="text-accent font-mono text-sm no-underline">
                  {project.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="border-border bg-surface min-w-0 rounded-lg border p-5 md:col-span-5">
        <h3 class="text-xl font-semibold">{site.lanes.systems.title}</h3>
        <p class="text-muted mt-3">{site.lanes.systems.body}</p>
        <ul class="mt-5 flex flex-col gap-2">
          {
            systemProjects.map((project) => (
              <li>
                <a href={projectHref(project)} class="text-accent font-mono text-sm no-underline">
                  {project.data.title}
                </a>
              </li>
            ))
          }
        </ul>
        {
          kvProject && (
            <a href={projectHref(kvProject)} class="mt-6 block no-underline">
              <RaftSim client:visible teaser />
            </a>
          )
        }
      </article>
    </div>
  </section>

  <section id="selected-work" class="reveal mt-20 md:mt-28">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <SectionEyebrow index="02" title="Selected work" heading />
      <a href="/work" class="text-accent font-mono text-xs no-underline">All projects</a>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      {featured.map((project) => <ToolCallCard project={project} />)}
    </div>
  </section>

  <section id="experience" class="reveal mt-20 md:mt-28">
    <SectionEyebrow index="03" title="Experience" heading />
    <p class="text-muted mt-2 font-mono text-xs">Mid-2024 to now</p>
    <div class="text-muted mt-4 hidden grid-cols-4 font-mono text-xs md:grid">
      <span>2024</span>
      <span class="text-center">2025</span>
      <span class="text-center">2026</span>
      <span class="text-right">now</span>
    </div>
    <div class="mt-4 flex flex-col gap-3">
      {
        experience.map((role) => {
          const range = spanRange(role.data.start, role.data.end);
          const groups = [...new Set(role.data.bullets.map((bullet) => bullet.group).filter(Boolean))];
          return (
            <details class="border-border bg-surface min-w-0 rounded-lg border p-4">
              <summary class="flex min-w-0 flex-col gap-3">
                <div class="flex min-w-0 flex-wrap items-baseline justify-between gap-2">
                  <div class="min-w-0">
                    <h3 class="text-base font-semibold">{role.data.company}</h3>
                    <p class="text-muted text-sm">
                      {role.data.role} · {role.data.location}
                    </p>
                  </div>
                  <p class="text-muted font-mono text-xs">
                    {formatYearMonth(role.data.start)} to {formatYearMonth(role.data.end)}
                  </p>
                </div>
                <SpanBar
                  start={range.start}
                  end={range.end}
                  label={`${role.data.company} from ${formatYearMonth(role.data.start)} to ${formatYearMonth(role.data.end)}`}
                />
              </summary>
              <div class="mt-4 flex flex-col gap-4">
                {groups.length > 0
                  ? groups.map((group) => (
                      <div>
                        <p class="text-muted font-mono text-xs tracking-eyebrow uppercase">{group}</p>
                        <ul class="mt-2 flex flex-col gap-3">
                          {role.data.bullets
                            .filter((bullet) => bullet.group === group)
                            .map((bullet) => (
                              <li class="min-w-0">
                                <TraceLine type="result" text={bullet.text} />
                                {bullet.metric && (
                                  <div class="mt-2">
                                    <MetricChip value={bullet.metric} />
                                  </div>
                                )}
                              </li>
                            ))}
                        </ul>
                      </div>
                    ))
                  : role.data.bullets.map((bullet) => (
                      <div class="min-w-0">
                        <TraceLine type="observe" text={bullet.text} />
                        {bullet.metric && (
                          <div class="mt-2">
                            <MetricChip value={bullet.metric} />
                          </div>
                        )}
                      </div>
                    ))}
              </div>
            </details>
          );
        })
      }
    </div>
  </section>

  <section id="open-source" class="reveal mt-20 md:mt-28">
    <SectionEyebrow index="04" title="Open source" heading />
    <ul class="mt-6 flex flex-col">
      {
        oss.map((entry) => (
          <li class="border-border flex min-w-0 flex-col gap-2 border-b py-4 last:border-b-0 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <a
                href={entry.data.url}
                class="text-accent font-mono text-sm no-underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                {entry.data.repo} #{entry.data.pr}
              </a>
              <p class="text-muted mt-1 text-sm">{entry.data.summary}</p>
            </div>
            <span class="border-accent text-accent shrink-0 rounded-md border px-1.5 py-0.5 font-mono text-xs uppercase">
              {entry.data.status}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="contact" class="reveal mt-20 md:mt-28">
    <SectionEyebrow index="05" title="Contact" heading />
    <article class="border-border bg-surface mt-6 rounded-lg border p-5">
      <p class="text-muted font-mono text-xs">Send a request</p>
      <p class="text-text mt-2 font-mono text-sm">contact(rohan)</p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm">
        <span class="inline-flex flex-wrap items-center gap-2">
          <a href={`mailto:${site.email}`} class="text-accent no-underline">{site.email}</a>
          <CopyEmail client:visible email={site.email} />
        </span>
        {
          site.linkedin && (
            <a
              href={site.linkedin}
              class="text-accent no-underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          )
        }
        <a href={site.github} class="text-accent no-underline" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </article>
  </section>
</Base>
