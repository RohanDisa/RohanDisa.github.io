---
import Base from '../layouts/Base.astro';
import SectionEyebrow from '../components/ui/SectionEyebrow.astro';

const pdfHref = '/Rohan_Disa_Resume.pdf';
---

<Base
  title="Resume · Rohan Disa"
  description="Resume for Rohan Disa, AI agent engineer."
  ogImage="/og/resume.png"
>
  <section>
    <SectionEyebrow index="01" title="Resume" />
    <h1 class="text-text mt-4 text-3xl">Resume</h1>
    <p class="text-muted mt-3 max-w-2xl">
      Download the PDF, or read it embedded on a larger screen.
    </p>

    <a
      href={pdfHref}
      class="bg-accent text-bg mt-8 flex items-center justify-center rounded-md px-6 py-4 text-center text-base font-medium no-underline md:hidden"
    >
      Download resume
    </a>

    <div class="border-border bg-surface mt-8 hidden overflow-hidden rounded-lg border md:block">
      <iframe
        src={pdfHref}
        title="Rohan Disa resume"
        class="h-[80vh] w-full bg-surface"
      ></iframe>
    </div>
  </section>
</Base>
